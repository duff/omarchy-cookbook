#!/bin/bash
# Run by scan-arrived.path when the scans folder in your Dropbox changes. The
# always-on machine names each scan by its day and a number, like
# 2026-10-17.001.pdf. For each one not seen yet, a notification offers to
# name it, and clicking it runs ./name. A missed one stays clickable in the
# notification history (Super+Shift+Alt+Comma).
set -euo pipefail

# The same folder as the always-on machine's dropbox:ScanSnap, as the Dropbox
# client syncs it here.
dir=$HOME/Dropbox/ScanSnap
seen=${XDG_STATE_HOME:-$HOME/.local/state}/scansnap/seen
mkdir -p "${seen%/*}"
touch "$seen"

for pdf in "$dir"/[0-9]*.pdf; do
  name=${pdf##*/}
  [[ $name =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\.[0-9]{3,}\.pdf$ ]] || continue
  grep -qxF "$name" "$seen" && continue
  pages=$(pdfinfo "$pdf" 2>/dev/null | awk '/^Pages:/ { print $2 }')
  scan="${name%.pdf} (${pages:-?} pages)"
  omarchy-notification-send --app-name Scans -u normal -t 30000 -i scanner \
    "New scan" "$scan. Click to name it." \
    --exec "$HOME/.config/scansnap/name" "$pdf" "$scan"
  echo "$name" >>"$seen"
done

# Forget scans that have since been named or removed.
kept=$(while read -r name; do if [[ -e $dir/$name ]]; then echo "$name"; fi; done <"$seen")
printf '%s' "${kept:+$kept$'\n'}" >"$seen"
